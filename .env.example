# ==============================================================================
# TrustGrid Platform Environment Configuration Template
# Copy this file to .env before starting containers:
# PowerShell: Copy-Item .env.example .env
# ==============================================================================

# Global Environment
ENVIRONMENT=development
LOG_LEVEL=debug

# Infrastructure - PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=trustgrid_admin
POSTGRES_SUPERUSER_PASSWORD=trustgrid_secure_password_dev

# Service Databases & Credentials
IDENTITY_DB_NAME=trustgrid_identity
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=identity_secure_pass_dev

VENDOR_DB_NAME=trustgrid_vendor
VENDOR_DB_USER=vendor_user
VENDOR_DB_PASSWORD=vendor_secure_pass_dev

WORKFLOW_DB_NAME=trustgrid_workflow
WORKFLOW_DB_USER=workflow_user
WORKFLOW_DB_PASSWORD=workflow_secure_pass_dev

RISK_DB_NAME=trustgrid_risk
RISK_DB_USER=risk_user
RISK_DB_PASSWORD=risk_secure_pass_dev

# Infrastructure - RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_DEFAULT_USER=trustgrid_mq
RABBITMQ_DEFAULT_PASS=trustgrid_mq_pass_dev
RABBITMQ_VHOST=trustgrid_vhost

# Infrastructure - Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=trustgrid_redis_pass_dev

# JWT & Authentication
JWT_SECRET_KEY=dev_insecure_jwt_secret_key_minimum_32_bytes_long_123
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=3600
