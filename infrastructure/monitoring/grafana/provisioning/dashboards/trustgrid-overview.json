      "title": "Service Uptime (Traefik Gateway & Microservices)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "up",
          "legendFormat": "{{ job }} ({{ instance }})"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Gateway Request Rate (req/sec by Service)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(traefik_service_requests_total[1m])) by (service)",
          "legendFormat": "{{ service }}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "p95 Gateway Latency (seconds)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(traefik_service_request_duration_seconds_bucket[2m])) by (le, service))",
          "legendFormat": "p95: {{ service }}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "RabbitMQ Ready Messages (Queue Depth)",
