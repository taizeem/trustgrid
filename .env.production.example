# ==============================================================================
# TrustGrid Production Environment Configuration Template
# NOTE: Never commit live secret values to version control.
# ==============================================================================

# Core Orchestration & Security
ENVIRONMENT=production
DEBUG=false
ALLOWED_HOSTS=api.trustgrid.internal,trustgrid.yourdomain.com
SECRET_KEY=generate_high_entropy_64_char_alphanumeric_django_secret_here

# JWT Authentication (Asymmetric RS256 recommended or 64-char HS256)
JWT_SECRET_KEY=generate_cryptographically_secure_random_64_byte_jwt_signing_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# PostgreSQL Production Database (Dedicated users with least privilege)
POSTGRES_HOST=postgres.internal.vpc
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require

POSTGRES_SUPERUSER=trustgrid_dba
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_SUPERUSER_STRONG_PASSWORD

IDENTITY_DB_NAME=trustgrid_identity
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=CHANGE_ME_IDENTITY_DB_PASSWORD

VENDOR_DB_NAME=trustgrid_vendor
VENDOR_DB_USER=vendor_user
VENDOR_DB_PASSWORD=CHANGE_ME_VENDOR_DB_PASSWORD

WORKFLOW_DB_NAME=trustgrid_workflow
WORKFLOW_DB_USER=workflow_user
WORKFLOW_DB_PASSWORD=CHANGE_ME_WORKFLOW_DB_PASSWORD

DOCUMENT_DB_NAME=trustgrid_document
DOCUMENT_DB_USER=document_user
DOCUMENT_DB_PASSWORD=CHANGE_ME_DOCUMENT_DB_PASSWORD

INTEGRATIONS_DB_NAME=trustgrid_integrations
INTEGRATIONS_DB_USER=integrations_user
INTEGRATIONS_DB_PASSWORD=CHANGE_ME_INTEGRATIONS_DB_PASSWORD

BILLING_DB_NAME=trustgrid_billing
BILLING_DB_USER=billing_user
BILLING_DB_PASSWORD=CHANGE_ME_BILLING_DB_PASSWORD

AUDIT_DB_NAME=trustgrid_audit
AUDIT_DB_USER=audit_user
AUDIT_DB_PASSWORD=CHANGE_ME_AUDIT_DB_PASSWORD

# RabbitMQ Inter-Service Messaging (TLS enabled)
RABBITMQ_HOST=rabbitmq.internal.vpc
RABBITMQ_PORT=5671
RABBITMQ_USE_SSL=true
RABBITMQ_USER=trustgrid_prod_app
RABBITMQ_PASS=CHANGE_ME_RABBITMQ_STRONG_PASSWORD
RABBITMQ_VHOST=trustgrid_prod_vhost

# Redis Rate Limiting & Ephemeral Cache
REDIS_HOST=redis.internal.vpc
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_STRONG_PASSWORD
REDIS_SSL=true

# S3-Compatible Encrypted Document Storage
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_BUCKET_NAME=trustgrid-production-evidence-storage
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=CHANGE_ME_AWS_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_KEY

# Payment Provider (Stripe Production API Keys)
STRIPE_SECRET_KEY=rk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
PAYMENT_SANDBOX_MODE=false

# Observability Credentials
GRAFANA_ADMIN_USER=trustgrid_ops
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD